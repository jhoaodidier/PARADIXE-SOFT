# ==============================================================================
# PARADIXE SOFT — Variables de Entorno (TakumiSoft)
# Copiar a .env para desarrollo local. Nunca versionar secretos reales.
# ==============================================================================

# Entorno de ejecucion: development | staging | production
APP_ENV=development
RUST_LOG=info,paradixe_api=debug,sqlx=warn
API_BIND_ADDR=0.0.0.0:8080

# PostgreSQL 16 + PostGIS 3.4 (Operacion Real)
POSTGRES_DB=paradixe_soft
POSTGRES_USER=paradixe_app
POSTGRES_PASSWORD=cambia_esta_clave_en_produccion
DATABASE_URL=postgres://paradixe_app:cambia_esta_clave_en_produccion@localhost:5432/paradixe_soft

# Principal restringido para Simulacros/Contingencia (solo lectura en tablas operativas)
SIMULATOR_DATABASE_URL=postgres://paradixe_sim_ro:cambia_clave_simulacros@localhost:5432/paradixe_soft

# Criptografia y Secretos (fuera de BD; en produccion usar KMS / Vault)
JWT_SECRET=reemplazar_por_secreto_256_bits_minimo_32_bytes
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
OTP_SECRET=reemplazar_por_secreto_hmac_otp_256_bits
TELEMETRY_KEY_STORE_DIR=./telemetry_keys

# Almacenamiento S3-compatible (Cloudflare R2 en prod / RustFS en dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin_dev_only
S3_BUCKET_MEDIA=paradixe-media
S3_BUCKET_TILES=paradixe-tiles

# Mensajeria Multicanal (WhatsApp Cloud API + SMS Fallback)
# Dejar vacio en entornos aislados; el gateway de simulacros bloquea todo egreso.
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=reemplazar_por_secreto_webhook_hmac
SMS_PROVIDER_API_KEY=

# Ingesta Climatica Real (paradixe-ingestor)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
NASA_GPM_BASE_URL=https://gpm.nasa.gov/api

# Observabilidad OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=paradixe-api
